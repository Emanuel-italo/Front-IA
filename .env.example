# Copie para .env.local (não vai para o git).

# Onde o serviço de IA (FastAPI) está rodando. Usado pelo proxy do Vite em `npm run dev`.
API_TARGET=http://localhost:8000

# Mesma SERVICE_API_KEY configurada no backend. Vazio = backend local sem autenticação.
# Fica só no proxy do Vite, nunca vai para o navegador.
SERVICE_API_KEY=

# Opcional, para build de produção: URL pública da API. Vazio = usa /api (proxy).
# Atenção: o serviço de IA não habilita CORS; em produção o front deve chamar a API Java/.NET
# ou um proxy reverso no mesmo domínio.
VITE_API_URL=
